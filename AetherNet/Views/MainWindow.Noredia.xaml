<Window x:Class="AetherNet.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AetherNet" Height="400" Width="340"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Border CornerRadius="16" Background="#0a0a0a" BorderThickness="0">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="35" ShadowDepth="0" Opacity="0.9"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- BAŞLIK -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="AETHERNET" 
                           FontSize="14" 
                           FontWeight="SemiBold" 
                           Foreground="#ff6b35" 
                           VerticalAlignment="Center" 
                           Margin="20,0,0,0"/>
                
                <Button Content="✕" Click="CloseBtn_Click" 
                        Width="40" Height="40" 
                        HorizontalAlignment="Right"
                        Background="Transparent" 
                        Foreground="#444" 
                        BorderThickness="0" 
                        FontSize="16" 
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="#ff6b35"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- ORTA ALAN -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="30,0">
                
                <!-- SERVİS DURUMU -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,20">
                    <TextBlock Text="Servis Durumu" 
                               FontSize="10" 
                               Foreground="#555" 
                               HorizontalAlignment="Center"
                               Margin="0,0,0,5"/>
                    <TextBlock x:Name="ServiceStatusText" 
                               Text="Yüklü Değil" 
                               FontSize="12" 
                               FontWeight="SemiBold"
                               Foreground="#ff6b35"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- DURUM -->
                <TextBlock x:Name="StatusText" 
                           Text="Sistem Kapalı" 
                           FontSize="13" 
                           FontWeight="Medium"
                           Foreground="#ff6b35" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,25"/>

                <!-- ANA BUTON -->
                <Button x:Name="ToggleBtn" Click="ToggleBtn_Click" 
                        Width="120" Height="120" 
                        Content="BAŞLAT" 
                        FontSize="16" 
                        FontWeight="Bold"
                        Foreground="White"
                        Cursor="Hand"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="60">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#ff6b35" Offset="0"/>
                                                    <GradientStop Color="#f7931e" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="0.9"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

            </StackPanel>

            <!-- ALT BUTONLAR -->
            <StackPanel Grid.Row="2" Margin="20,0,20,20">
                
                <Button x:Name="InstallServiceBtn" Click="InstallServiceBtn_Click"
                        Height="38"
                        FontSize="12" 
                        FontWeight="Medium"
                        Foreground="White"
                        Cursor="Hand"
                        Margin="0,0,0,8">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="10">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#ff6b35" Offset="0"/>
                                                    <GradientStop Color="#f7931e" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="📦" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="0.9"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="Servis Yükle"/>
                </Button>

                <Button x:Name="UninstallServiceBtn" Click="UninstallServiceBtn_Click"
                        Height="38"
                        FontSize="12" 
                        FontWeight="Medium"
                        Foreground="White"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="10">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#ff6b35" Offset="0"/>
                                                    <GradientStop Color="#f7931e" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="🗑️" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="0.9"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="Servis Kaldır"/>
                </Button>

            </StackPanel>
        </Grid>
    </Border>
</Window>
