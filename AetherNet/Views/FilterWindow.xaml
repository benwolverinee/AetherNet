<Window x:Class="AetherNet.Views.FilterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Uygulama Filtreleri" Height="500" Width="500"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Border CornerRadius="15" Background="#0F111A" BorderBrush="#00E5FF" BorderThickness="2">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- BAŞLIK -->
            <Grid Grid.Row="0">
                <TextBlock Text="⚙️ Uygulama Filtreleri" 
                           FontSize="18" FontWeight="Bold" 
                           Foreground="#00E5FF" 
                           VerticalAlignment="Center"/>
                
                <Button Content="✕" Click="CloseBtn_Click" 
                        Width="28" Height="28" 
                        HorizontalAlignment="Right"
                        Background="Transparent" Foreground="Gray" 
                        BorderThickness="0" FontSize="18" Cursor="Hand"/>
            </Grid>

            <!-- MOD SEÇİMİ -->
            <StackPanel Grid.Row="1" Margin="0,20,0,0">
                <TextBlock Text="Filtreleme Modu:" FontSize="12" Foreground="Gray" Margin="0,0,0,8"/>
                
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="WhitelistMode" Content="Whitelist (Sadece seçilenler)" 
                                 GroupName="FilterMode" IsChecked="True"
                                 Foreground="White" FontSize="11" Margin="0,0,15,0"
                                 Checked="FilterMode_Changed"/>
                    <RadioButton x:Name="BlacklistMode" Content="Blacklist (Seçilenler hariç)" 
                                 GroupName="FilterMode"
                                 Foreground="White" FontSize="11"
                                 Checked="FilterMode_Changed"/>
                </StackPanel>

                <TextBlock x:Name="ModeDescription" 
                           Text=""
                           FontSize="10" Foreground="#00E5FF" 
                           Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- UYGULAMA LİSTESİ -->
            <Border Grid.Row="2" Margin="0,15,0,0" 
                    Background="#1E293B" CornerRadius="8" 
                    BorderBrush="#00E5FF" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="AppListPanel" Margin="10"/>
                </ScrollViewer>
            </Border>

            <!-- ALT BUTONLAR -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" 
                        HorizontalAlignment="Center" Margin="0,15,0,0">
                <Button Content="➕ Uygulama Ekle" Click="AddAppBtn_Click"
                        Width="140" Height="35"
                        FontSize="12" FontWeight="SemiBold"
                        Foreground="White" Background="#1E293B"
                        BorderBrush="#00E5FF" BorderThickness="1.5"
                        Cursor="Hand" Margin="0,0,10,0"/>
                
                <Button Content="💾 Kaydet" Click="SaveBtn_Click"
                        Width="140" Height="35"
                        FontSize="12" FontWeight="SemiBold"
                        Foreground="White" Background="#1E293B"
                        BorderBrush="#00E5FF" BorderThickness="1.5"
                        Cursor="Hand" Margin="10,0,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
