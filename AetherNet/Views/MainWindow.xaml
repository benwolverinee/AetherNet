<Window x:Class="AetherNet.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AetherNet - DPI Bypass" Height="400" Width="450"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Border CornerRadius="15" Background="#0F111A" BorderBrush="#00E5FF" BorderThickness="2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- BAŞLIK BARI -->
            <Grid Grid.Row="0" Margin="20,15,20,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚡" FontSize="24" Foreground="#00E5FF" VerticalAlignment="Center"/>
                    <TextBlock Text="AETHERNET" FontSize="20" FontWeight="Bold" Foreground="#00E5FF" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="v1.0" FontSize="11" Foreground="Gray" Margin="8,8,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                
                <Button Content="✕" Click="CloseBtn_Click" 
                        Width="28" Height="28" 
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="Transparent" Foreground="Gray" 
                        BorderThickness="0" FontSize="18" Cursor="Hand"
                        Padding="0,-3,0,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="#FF4C4C"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- ORTA KISIM -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- DURUM METNİ -->
                <TextBlock x:Name="StatusText" 
                           Text="Sistem Kapali" 
                           FontSize="14" 
                           Foreground="#FF4C4C" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,25"
                           TextAlignment="Center"/>

                <!-- ANA BUTON -->
                <Button x:Name="ToggleBtn" Click="ToggleBtn_Click" 
                        Width="130" Height="130" 
                        Content="BASLAT" 
                        FontSize="18" FontWeight="Bold"
                        Foreground="White"
                        Background="#1E293B"
                        BorderBrush="#00E5FF" BorderThickness="3"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Border" 
                                                Background="{TemplateBinding Background}" 
                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="{TemplateBinding BorderThickness}" 
                                                CornerRadius="65">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#00E5FF"/>
                                                <Setter Property="Foreground" Value="Black"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- SERVİS BUTONLARI -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <Button x:Name="InstallServiceBtn" Click="InstallServiceBtn_Click"
                            Content="📦 Servis Yükle"
                            Width="120" Height="32"
                            FontSize="11" FontWeight="SemiBold"
                            Foreground="White"
                            Background="#1E293B"
                            BorderBrush="#00E5FF" BorderThickness="1.5"
                            Cursor="Hand"
                            Margin="0,0,8,0"/>

                    <Button x:Name="UninstallServiceBtn" Click="UninstallServiceBtn_Click"
                            Content="🗑️ Servis Kaldır"
                            Width="120" Height="32"
                            FontSize="11" FontWeight="SemiBold"
                            Foreground="White"
                            Background="#1E293B"
                            BorderBrush="#FF4C4C" BorderThickness="1.5"
                            Cursor="Hand"
                            Margin="8,0,0,0"/>
                </StackPanel>

                <!-- BİLGİ METNİ -->
                <TextBlock Text="WinDivert DPI Bypass (Discord, Telegram, Web)" 
                           FontSize="10" 
                           Foreground="Gray" 
                           HorizontalAlignment="Center" 
                           Margin="0,15,0,15"
                           TextAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
