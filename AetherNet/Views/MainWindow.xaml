<Window
    x:Class="AetherNet.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AetherNet"
    Width="340"
    Height="400"
    AllowsTransparency="True"
    Background="Transparent"
    RenderOptions.ClearTypeHint="Enabled"
    ResizeMode="NoResize"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="ClearType"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">

    <Window.Resources>
        <!--  Ateş Gradient — Normal  -->
        <LinearGradientBrush x:Key="FireBrush" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Offset="0" Color="#C2C2C2" />
            <GradientStop Offset="0.5" Color="#D2D2D2" />
            <GradientStop Offset="1" Color="#BEBEBE" />
        </LinearGradientBrush>

        <!--  Ateş Gradient — Hover  -->
        <LinearGradientBrush x:Key="FireBrushHover" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Offset="0" Color="#FFFFFF" />
            <GradientStop Offset="0.45" Color="#FFFFFF" />
            <GradientStop Offset="1" Color="#FFFFFF" />
        </LinearGradientBrush>
    </Window.Resources>

    <!--  PENCERE ARKAPLAN VE KENAR  -->
    <!--  Background: Arkaplan rengi  -->
    <!--  BorderBrush: Kenar rengi  -->
    <!--  CornerRadius: Köşe yuvarlaklığı  -->
    <Border
        Background="#0C0C11"
        BorderBrush="#2a2a2a"
        BorderThickness="0"
        CornerRadius="10">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="71*" />
                <RowDefinition Height="72*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  BAŞLIK BARI  -->
            <Grid
                Grid.Row="0"
                Background="Transparent"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <!--  SOL TARAF: DURUM IŞIĞI + AETHERNET YAZISI  -->
                <!--  Margin="15,0,0,0" = Sol boşluk  -->
                <StackPanel
                    Margin="15,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <!--  DURUM IŞIĞI (Kırmızı/Yeşil)  -->
                    <Ellipse
                        x:Name="StatusIndicator"
                        Width="8"
                        Height="8"
                        Margin="0,0,10,0"
                        Fill="#ff4c4c">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#ff4c4c" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                        </Ellipse.Effect>
                    </Ellipse>

                    <!--  AETHERNET YAZISI  -->
                    <!--  FontSize: Yazı boyutu  -->
                    <!--  Foreground: Yazı rengi  -->
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12.5"
                        FontWeight="Bold"
                        Foreground="#d0d0d0"
                        Text="AetherNet" />
                </StackPanel>

                <!--  SAĞ TARAF: MİNİMİZE VE KAPAT BUTONLARI  -->
                <StackPanel
                    Margin="0,0,10,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button
                        Width="35"
                        Height="35"
                        Margin="0,0,5,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Content="—"
                        Cursor="Hand"
                        FontSize="16"
                        Foreground="#666">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="#999" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button
                        Width="35"
                        Height="35"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="CloseBtn_Click"
                        Content="✕"
                        Cursor="Hand"
                        FontSize="16"
                        Foreground="#666">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="#999" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>

            <!--  ORTA ALAN  -->
            <!--  Margin="30,0" = Sağ-Sol boşluk  -->
            <StackPanel
                Grid.Row="1"
                Grid.RowSpan="2"
                Margin="30,0,30,0"
                VerticalAlignment="Center">

                <!--  SERVİS DURUMU  -->
                <!--  Margin="0,0,0,20" = Alt boşluk  -->
                <StackPanel Margin="0,0,0,20" HorizontalAlignment="Center">
                    <!--  "Servis Durumu" YAZISI  -->
                    <!--  FontSize: Yazı boyutu  -->
                    <!--  Foreground: Yazı rengi  -->
                    <TextBlock
                        Margin="0,0,0,5"
                        HorizontalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="#666"
                        Text="Servis Durumu" />

                    <!--  "Yüklü Değil" YAZISI  -->
                    <!--  FontSize: Yazı boyutu  -->
                    <!--  Foreground: Yazı rengi  -->
                    <TextBlock
                        x:Name="ServiceStatusText"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#FFFFFF"
                        Text="Yüklü Değil" />
                </StackPanel>

                <!--  DURUM YAZISI  -->
                <!--  FontSize: Yazı boyutu  -->
                <!--  Foreground: Yazı rengi  -->
                <!--  Margin="0,0,0,25" = Alt boşluk  -->
                <TextBlock
                    x:Name="StatusText"
                    Margin="0,0,0,25"
                    HorizontalAlignment="Center"
                    FontSize="14"
                    FontWeight="Medium"
                    Foreground="#ff6b35"
                    Text="" />

                <!--  BAŞLAT BUTONU  -->
                <!--  Width/Height: Buton boyutu  -->
                <!--  FontSize: Yazı boyutu  -->
                <!--  Foreground: Yazı rengi  -->
                <Button
                    x:Name="ToggleBtn"
                    Width="100"
                    Height="100"
                    Margin="5,0,0,20"
                    HorizontalAlignment="Center"
                    Click="ToggleBtn_Click"
                    Content="BAŞLAT"
                    Cursor="Hand"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="#1a1a1a"
                    RenderTransformOrigin="0.5,0.5"
                    TextOptions.TextFormattingMode="Ideal"
                    TextOptions.TextRenderingMode="ClearType">
                    <Button.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1" />
                    </Button.RenderTransform>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Grid>
                                            <!--  Glow katmanı  -->
                                            <Border
                                                x:Name="GlowBorder"
                                                Margin="-4"
                                                Background="Transparent"
                                                CornerRadius="55"
                                                Opacity="0.3">
                                                <Border.Effect>
                                                    <DropShadowEffect
                                                        BlurRadius="25"
                                                        Opacity="0.6"
                                                        ShadowDepth="0"
                                                        Color="#FFFFFF" />
                                                </Border.Effect>
                                            </Border>
                                            <!--  Ana buton  -->
                                            <Border x:Name="ButtonBorder" CornerRadius="55">
                                                <Border.Background>
                                                    <StaticResource ResourceKey="FireBrush" />
                                                </Border.Background>
                                                <Border.Effect>
                                                    <DropShadowEffect
                                                        BlurRadius="14"
                                                        Opacity="0.3"
                                                        ShadowDepth="0"
                                                        Color="#000000" />
                                                </Border.Effect>
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource FireBrushHover}" />
                                                <Setter TargetName="ButtonBorder" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect
                                                            BlurRadius="1"
                                                            Opacity="0.50"
                                                            ShadowDepth="0"
                                                            Color="#00FFC446" />
                                                    </Setter.Value>
                                                </Setter>
                                                <Setter TargetName="GlowBorder" Property="Opacity" Value="5.7" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value>
                                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                                                    </Setter.Value>
                                                </Setter>
                                                <Setter TargetName="ButtonBorder" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect
                                                            BlurRadius="8"
                                                            Opacity="0.2"
                                                            ShadowDepth="0"
                                                            Color="#03D4421A" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <!--  Üzerine gelince büyüme animasyonu  -->
                                <EventTrigger RoutedEvent="Mouse.MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                To="1.03"
                                                Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                To="1.03"
                                                Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <!--  Ayrılınca eski boyut  -->
                                <EventTrigger RoutedEvent="Mouse.MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                To="1.0"
                                                Duration="0:0:0.15" />
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                To="1.0"
                                                Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

            </StackPanel>

            <!--  ALT BUTONLAR  -->
            <!--  Grid: Yan yana butonlar için  -->
            <Grid Grid.Row="3" Margin="20,0,20,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  SERVİS YÜKLE BUTONU (SOLDA)  -->
                <!--  Height: Buton yüksekliği  -->
                <!--  FontSize: Yazı boyutu  -->
                <!--  Foreground: Yazı rengi  -->
                <Button
                    x:Name="InstallServiceBtn"
                    Grid.Column="0"
                    Height="42"
                    Click="InstallServiceBtn_Click"
                    Cursor="Hand"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="#1a1a1a"
                    RenderTransformOrigin="0.5,0.5">
                    <Button.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1" />
                    </Button.RenderTransform>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <!--  CornerRadius: Köşe yuvarlaklığı  -->
                                        <Border x:Name="ButtonBorder" CornerRadius="12">
                                            <!--  NORMAL RENK  -->
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Offset="0" Color="#CECECE" />
                                                    <GradientStop Offset="1" Color="#CECECE" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                                <TextBlock
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="14"
                                                    Text="📦" />
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <!--  HOVER ANIMASYON  -->
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation
                                                                Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleX)"
                                                                To="1.03"
                                                                Duration="0:0:0.25">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                            <DoubleAnimation
                                                                Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleY)"
                                                                To="1.03"
                                                                Duration="0:0:0.25">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation
                                                                Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleX)"
                                                                To="1"
                                                                Duration="0:0:0.25">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                            <DoubleAnimation
                                                                Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleY)"
                                                                To="1"
                                                                Duration="0:0:0.25">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                                <Setter TargetName="ButtonBorder" Property="Background">
                                                    <Setter.Value>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Offset="2" Color="#FFFFFF" />
                                                            <GradientStop Offset="2" Color="#FFFFFF" />
                                                        </LinearGradientBrush>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="Servis Yükle" />
                </Button>

                <!--  SERVİS KALDIR BUTONU (SAĞDA)  -->
                <!--  Height: Buton yüksekliği  -->
                <!--  FontSize: Yazı boyutu  -->
                <!--  Foreground: Yazı rengi  -->
                <Button
                    x:Name="UninstallServiceBtn"
                    Grid.Column="2"
                    Height="42"
                    Click="UninstallServiceBtn_Click"
                    Cursor="Hand"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="#1a1a1a"
                    RenderTransformOrigin="0.5,0.5">
                    <Button.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1" />
                    </Button.RenderTransform>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ButtonBorder" CornerRadius="12">
                                            <!--  NORMAL RENK  -->
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Offset="0" Color="#CECECE" />
                                                    <GradientStop Offset="1" Color="#CECECE" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                                <TextBlock
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="14"
                                                    Text="🗑️" />
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <!--  HOVER ANIMASYON  -->
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation
                                                                Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleX)"
                                                                To="1.03"
                                                                Duration="0:0:0.25">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                            <DoubleAnimation
                                                                Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleY)"
                                                                To="1.03"
                                                                Duration="0:0:0.25">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation
                                                                Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleX)"
                                                                To="1"
                                                                Duration="0:0:0.25">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                            <DoubleAnimation
                                                                Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleY)"
                                                                To="1"
                                                                Duration="0:0:0.25">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                                <Setter TargetName="ButtonBorder" Property="Background">
                                                    <Setter.Value>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Offset="2" Color="#FFFFFF" />
                                                            <GradientStop Offset="2" Color="#FFFFFF" />
                                                        </LinearGradientBrush>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="Servis Kaldır" />
                </Button>

            </Grid>
        </Grid>
    </Border>
</Window>
