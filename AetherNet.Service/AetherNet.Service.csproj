<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <OutputType>Exe</OutputType>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.0" />
  </ItemGroup>

  <!-- Build sonrası dosyaları organize et -->
  <Target Name="OrganizeServiceOutput" AfterTargets="Build">
    <!-- Gereksiz appsettings dosyalarını sil -->
    <Delete Files="$(OutDir)appsettings.json;$(OutDir)appsettings.Development.json" />
    
    <!-- Gereksiz klasörleri sil -->
    <RemoveDir Condition="Exists('$(OutDir)lib')" Directories="$(OutDir)lib" />
    <RemoveDir Condition="Exists('$(OutDir)Native')" Directories="$(OutDir)Native" />
  </Target>

</Project>
